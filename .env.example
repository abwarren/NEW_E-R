# E&R PokerBet environment template — copy to .env, NEVER commit real values
ER_PORT=8090
# Local dev: 127.0.0.1. Multi-device/remote: 0.0.0.0 (behind firewall/VPN/HTTPS
# reverse proxy — see docs/DEPLOYMENT.md §7)
ER_HOST=127.0.0.1
# Generate: python3 -c "import secrets; print(secrets.token_hex(24))"
ER_API_KEY=change-me
# SQLite default; PostgreSQL: postgresql+psycopg2://user:pass@localhost:5432/new_er
ER_DB_URL=sqlite:////home/gdi/NEW_E-R/data/er_state.db
ER_PLAYERS_DB=/home/gdi/NEW_E-R/data/players.db
ER_ALLOWED_ORIGINS=
ER_EQUITY_VARIANT=plo
ER_EQUITY_SAMPLES=2000
ER_STALE_SNAPSHOT_SECONDS=30
ER_COMMAND_TIMEOUT_SECONDS=20
